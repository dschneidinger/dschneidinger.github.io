---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList, { type Entry } from '../components/EntryList.astro';
import { getEssays, getNotes, formatDate, isoDate } from '../lib/content';
import { getPage, getSite } from '../lib/site';

const site = await getSite();
const page = await getPage('home');
const { Content } = await render(page);

const [essays, notes] = await Promise.all([getEssays(), getNotes()]);

const recentEssays: Entry[] = essays.slice(0, 4).map((essay) => ({
  href: `/writing/${essay.id}/`,
  title: essay.data.title,
  description: essay.data.description,
  datetime: isoDate(essay.data.pubDate),
  meta: formatDate(essay.data.pubDate),
}));

const recentNotes: Entry[] = notes.slice(0, 4).map((note) => ({
  href: `/notes/${note.id}/`,
  title: note.data.title,
  description: note.data.description,
  datetime: isoDate(note.data.updated),
  meta: `${note.data.maturity} · updated ${formatDate(note.data.updated)}`,
}));
---

<Base description={page.data.description}>
  <h1 class="sr-only">{site.title}</h1>

  <section class="intro prose">
    <Content />
  </section>

  <section class="home-section">
    <h2 class="home-section__heading">Recent writing</h2>
    <EntryList entries={recentEssays} empty="No essays published yet." />
    {
      essays.length > recentEssays.length && (
        <p class="home-section__more">
          <a href="/writing">All writing →</a>
        </p>
      )
    }
  </section>

  <section class="home-section">
    <h2 class="home-section__heading">Recent notes</h2>
    <EntryList entries={recentNotes} empty="No notes yet." />
    {
      notes.length > recentNotes.length && (
        <p class="home-section__more">
          <a href="/notes">All notes →</a>
        </p>
      )
    }
  </section>
</Base>

<style>
  .intro {
    max-width: 58ch;
    margin-block-end: var(--space-2xl);
    text-wrap: pretty;
  }

  .home-section + .home-section {
    margin-block-start: var(--space-2xl);
  }

  .home-section__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-block-end: var(--space-m);
  }

  .home-section__more {
    margin-block-start: var(--space-m);
    font-size: var(--text-sm);
  }
</style>
