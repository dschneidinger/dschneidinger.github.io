---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList, { type Entry } from '../../components/EntryList.astro';
import { getNotes, formatDate, isoDate } from '../../lib/content';
import { getPage } from '../../lib/site';

const page = await getPage('notes');
const { Content } = await render(page);

const items = await getNotes();
const entries: Entry[] = items.map((item) => ({
  href: `/notes/${item.id}/`,
  title: item.data.title,
  description: item.data.description,
  datetime: isoDate(item.data.updated),
  meta: `${item.data.maturity} · updated ${formatDate(item.data.updated)}`,
}));
---

<Base title={page.data.title} description={page.data.description}>
  <h1 class="page-title">{page.data.title}</h1>
  <div class="page-intro prose">
    <Content />
  </div>
  <EntryList entries={entries} empty="No notes yet." />
</Base>
