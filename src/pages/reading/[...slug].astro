---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { getReading, formatDate, isoDate } from '../../lib/content';

export const getStaticPaths = (async () => {
  const reading = await getReading();
  return reading.map((item) => ({ params: { slug: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const { Content } = await render(item);
const { title, author, year, dateRead, link, description, tags } = item.data;

const dateline = [author, year, `read ${formatDate(dateRead)}`].filter(Boolean).join(' · ');
---

<Prose
  title={title}
  description={description ?? `Notes on ${title} by ${author}.`}
  dateline={dateline}
  datetime={isoDate(dateRead)}
  tags={tags}
  article={{ published: dateRead }}
>
  {link && (
    <p class="source-link">
      <a href={link} rel="noopener">Source</a>
    </p>
  )}
  <Content />
</Prose>
