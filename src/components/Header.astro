---
import { SITE, NAV } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href="/">{SITE.title}</a>
    <nav aria-label="Primary">
      <ul>
        {
          NAV.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-l) var(--space-xl);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
  }

  .site-header__name {
    font-weight: 600;
    font-size: 1.05em;
    color: var(--ink);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .site-header__name:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  /* The current section is marked with weight and ink, not colour alone. */
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }
</style>
